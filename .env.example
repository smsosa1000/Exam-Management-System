# ExamGuard Pro — Environment Configuration
# ============================================

# Server
PORT=3000
NODE_ENV=development

# JWT Secret (change in production)
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=2h

# AES-256-CBC Encryption Key (32 bytes hex)
AES_KEY=replace_with_64_hex_chars
AES_IV=replace_with_32_hex_chars

# Session
SESSION_SECRET=replace_with_a_long_random_string
SESSION_MAX_AGE=7200000

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5

# Account Lockout
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900000

# Database
DB_PATH=./database/examguard.db

# Optional: Redis (refresh-token tracking, email queue) and SendGrid (email)
# REDIS_URL=redis://127.0.0.1:6379
# SENDGRID_API_KEY=
# SENDGRID_FROM=no-reply@example.com
