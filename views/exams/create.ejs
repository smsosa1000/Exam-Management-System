<%- include('../partials/header') %>
<div class="app-layout">
  <%- include('../partials/sidebar') %>
  <main class="main-content">
    <div class="top-bar"><h1 class="page-title">➕ Create Exam</h1></div>
    <div class="content-area fade-in">
      <% if (error) { %><div class="alert alert-error">⚠️ <%= error %></div><% } %>
      <form method="POST" action="/exams/create" id="createExamForm">
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px">
          <div class="card">
            <h3 class="card-title" style="margin-bottom:20px">📝 Exam Details</h3>
            <div class="form-group"><label class="form-label">Exam Title *</label><input type="text" class="form-input" name="title" required value="<%= typeof formData !== 'undefined' ? formData.title : '' %>"></div>
            <div class="form-group"><label class="form-label">Course Name *</label><input type="text" class="form-input" name="course_name" required value="<%= typeof formData !== 'undefined' ? formData.course_name : '' %>"></div>
            <div class="form-group"><label class="form-label">Description</label><textarea class="form-textarea" name="description"><%= typeof formData !== 'undefined' ? formData.description : '' %></textarea></div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
              <div class="form-group"><label class="form-label">Duration (Minutes)</label><input type="number" class="form-input" name="duration_minutes" value="<%= typeof formData !== 'undefined' && formData.duration_minutes ? formData.duration_minutes : '60' %>" min="5"></div>
              <div class="form-group"><label class="form-label">Total Marks</label><input type="number" class="form-input" name="total_marks" value="<%= typeof formData !== 'undefined' && formData.total_marks ? formData.total_marks : '100' %>" min="1"></div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
              <div class="form-group"><label class="form-label">Pass Marks *</label><input type="number" class="form-input" name="pass_marks" value="<%= typeof formData !== 'undefined' && formData.pass_marks ? formData.pass_marks : '50' %>" required></div>
              <div class="form-group"><label class="form-label">Max Attempts</label><input type="number" class="form-input" name="max_attempts" value="<%= typeof formData !== 'undefined' && formData.max_attempts ? formData.max_attempts : '1' %>" min="1"></div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
              <div class="form-group"><label class="form-label">Start Time *</label><input type="datetime-local" class="form-input" name="start_time" required value="<%= typeof formData !== 'undefined' ? formData.start_time : '' %>"></div>
              <div class="form-group"><label class="form-label">End Time *</label><input type="datetime-local" class="form-input" name="end_time" required value="<%= typeof formData !== 'undefined' ? formData.end_time : '' %>"></div>
            </div>
            <div class="form-group"><label class="form-label"><input type="checkbox" name="is_randomized" <%= typeof formData !== 'undefined' && formData.is_randomized ? 'checked' : '' %>> Randomize Questions</label></div>
            <div class="form-group"><label class="form-label"><input type="checkbox" name="anti_cheat_enabled" <%= typeof formData !== 'undefined' && formData.anti_cheat_enabled ? 'checked' : '' %>> Enable Anti-Cheat</label></div>
          </div>
          <div class="card" style="display:flex; flex-direction:column;">
            <h3 class="card-title" style="margin-bottom:12px">👨‍🎓 Enroll Students</h3>
            <div style="display:flex; gap:8px; margin-bottom:12px; flex-wrap:wrap;">
              <input type="text" class="form-input" id="studentFilter" placeholder="Filter by name..." style="flex:1; min-width:150px; font-size:13px;" onkeyup="filterStudents()">
              
              <select class="form-select" id="deptFilter" style="width:120px; font-size:13px;" onchange="filterStudents()">
                <option value="">All Majors</option>
                <% [...new Set(students.map(s => s.department))].filter(Boolean).forEach(function(dept) { %>
                  <option value="<%= dept %>"><%= dept %></option>
                <% }); %>
              </select>

              <select class="form-select" id="groupFilter" style="width:120px; font-size:13px;" onchange="filterStudents()">
                <option value="">All Groups</option>
                <% if (typeof groups !== 'undefined') { groups.forEach(function(g) { %>
                  <option value="<%= g.id %>"><%= g.name %></option>
                <% }); } %>
              </select>

              <select class="form-select" id="roleFilter" style="width:120px; font-size:13px;" onchange="filterStudents()">
                <option value="">All Roles</option>
                <% if (typeof customRoles !== 'undefined') { customRoles.forEach(function(r) { %>
                  <option value="<%= r.id %>"><%= r.name %></option>
                <% }); } %>
              </select>

              <button type="button" class="btn btn-secondary btn-sm" onclick="selectAllVisible()">Select All</button>
            </div>
            <div style="max-height:450px; overflow-y:auto; border:1px solid var(--border); border-radius:6px; background:var(--bg-input);" id="studentListContainer">
              <% students.forEach(function(s) { %>
              <label class="student-item" style="display:flex;align-items:center;gap:10px;padding:8px 12px;border-bottom:1px solid var(--border);cursor:pointer;font-size:14px;transition:background 0.2s;" onmouseenter="this.style.background='var(--bg-card)'" onmouseleave="this.style.background='transparent'">
                <input type="checkbox" name="enrolled_students" class="student-checkbox" value="<%= s.id %>" 
                       data-group="<%= s.group_id || '' %>" 
                       data-roles="<%= s.role_ids || '' %>"
                       data-dept="<%= s.department %>">
                <div style="flex-grow:1;">
                  <div style="font-weight:600" class="student-name"><%= s.full_name %></div>
                  <div style="font-size:11px;color:var(--text-muted)" class="student-dept">@<%= s.username %> · <%= s.department %></div>
                </div>
              </label>
              <% }); %>
            </div>
          </div>
        </div>
        <div style="margin-top:24px;text-align:right">
          <button type="submit" class="btn btn-primary btn-lg">🚀 Create Exam</button>
        </div>
      </form>
    </div>
</div>
<script>
function filterStudents() {
  const query = document.getElementById('studentFilter').value.toLowerCase();
  const deptId = document.getElementById('deptFilter').value;
  const groupId = document.getElementById('groupFilter').value;
  const roleId = document.getElementById('roleFilter').value;
  const items = document.querySelectorAll('.student-item');
  
  items.forEach(item => {
    const cb = item.querySelector('.student-checkbox');
    const name = item.querySelector('.student-name').textContent.toLowerCase();
    const dept = cb.getAttribute('data-dept');
    const group = cb.getAttribute('data-group');
    const roles = cb.getAttribute('data-roles').split(',');
    
    const matchesQuery = name.includes(query);
    const matchesDept = deptId === '' || dept === deptId;
    const matchesGroup = groupId === '' || group === groupId;
    const matchesRole = roleId === '' || roles.includes(roleId);
    
    if (matchesQuery && matchesDept && matchesGroup && matchesRole) {
      item.style.display = 'flex';
    } else {
      item.style.display = 'none';
    }
  });
}

function selectAllVisible() {
  const items = document.querySelectorAll('.student-item');
  let checkedCount = 0;
  let visibleCount = 0;
  
  // Check how many are currently checked
  items.forEach(item => {
    if (item.style.display !== 'none') {
      visibleCount++;
      if (item.querySelector('.student-checkbox').checked) checkedCount++;
    }
  });
  
  // If all visible are checked, uncheck them. Otherwise, check them all.
  const checkState = checkedCount !== visibleCount;
  
  items.forEach(item => {
    if (item.style.display !== 'none') {
      item.querySelector('.student-checkbox').checked = checkState;
    }
  });
}
</script>
<%- include('../partials/footer') %>
