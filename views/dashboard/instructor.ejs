<%- include('../partials/header') %>
<div class="app-layout">
  <%- include('../partials/sidebar') %>
  <main class="main-content">
    <div class="top-bar">
      <h1 class="page-title">📚 Instructor Dashboard</h1>
      <span class="badge badge-warning">INSTRUCTOR</span>
    </div>
    <div class="content-area fade-in">
      <div class="stats-grid">
        <div class="stat-card"><div class="stat-icon">📝</div><div class="stat-value"><%= stats.totalExams %></div><div class="stat-label">My Exams</div></div>
        <div class="stat-card"><div class="stat-icon">👨‍🎓</div><div class="stat-value"><%= stats.totalStudents %></div><div class="stat-label">Enrolled Students</div></div>
        <div class="stat-card"><div class="stat-icon">📊</div><div class="stat-value"><%= stats.totalSessions %></div><div class="stat-label">Submissions</div></div>
      </div>
      
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px">
        <!-- My Exams -->
        <div class="card">
          <div class="card-header"><h3 class="card-title">📝 My Exams</h3><a href="/exams/create" class="btn btn-sm btn-primary">+ Create Exam</a></div>
          <% if (myExams.length === 0) { %>
            <p style="color:var(--text-muted);text-align:center;padding:20px">No exams created yet.</p>
          <% } else { myExams.forEach(function(exam) { %>
          <div style="padding:16px 0;border-bottom:1px solid var(--border)">
            <div style="display:flex;justify-content:space-between;align-items:flex-start">
              <div style="flex:1">
                <div style="font-weight:600;font-size:15px;margin-bottom:4px">
                  <%= exam.title %> 
                  <span style="font-size:11px; font-weight:normal; background:var(--bg-card); border:1px dashed var(--primary); padding:2px 6px; border-radius:4px; margin-left:8px; color:var(--primary)">Room: <strong><%= exam.room_code || 'N/A' %></strong></span>
                </div>
                <div style="font-size:12px;color:var(--text-muted);margin-bottom:8px"><%= exam.course_name %> · <%= exam.duration_minutes %> min</div>
                
                <% if (exam.avg_score !== null) { %>
                <div style="display:flex; gap:12px; font-size:11px;">
                  <span title="Average Score" style="color:var(--info)">📊 Avg: <strong><%= Math.round(exam.avg_score) %>%</strong></span>
                  <span title="Lowest Score" style="color:var(--danger)">📉 Min: <strong><%= exam.min_score %>%</strong></span>
                  <span title="Highest Score" style="color:var(--success)">🏆 Max: <strong><%= exam.max_score %>%</strong></span>
                </div>
                <% } else { %>
                <div style="font-size:11px; color:var(--text-muted)">No submissions yet</div>
                <% } %>
              </div>
              <div style="display:flex;gap:8px;align-items:center;margin-top:4px">
                <span class="badge badge-<%= exam.status === 'published' ? 'success' : exam.status === 'draft' ? 'warning' : 'info' %>"><%= exam.status %></span>
                <a href="/exams/<%= exam.id %>/manage-questions" class="btn btn-sm btn-secondary">Manage</a>
                <% if (exam.status === 'draft') { %>
                  <form method="POST" action="/exams/<%= exam.id %>/publish" style="display:inline"><input type="hidden" name="_csrf" value="<%= locals.csrfToken %>"><button type="submit" class="btn btn-sm btn-success">Publish</button></form>
                <% } %>
              </div>
            </div>
          </div>
          <% }); } %>
        </div>

        <!-- Recent Submissions -->
        <div class="card">
          <div class="card-header"><h3 class="card-title">📊 Recent Submissions</h3></div>
          <% if (recentSubmissions.length === 0) { %>
            <p style="color:var(--text-muted);text-align:center;padding:20px">No submissions yet.</p>
          <% } else { recentSubmissions.forEach(function(sub) { %>
          <div style="padding:10px 0;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center">
            <div>
              <div style="font-weight:600;font-size:13px"><%= sub.student_name %></div>
              <div style="font-size:11px;color:var(--text-muted)"><%= sub.exam_title %></div>
            </div>
            <div style="text-align:right">
              <div style="font-weight:700;color:<%= (sub.percentage || 0) >= 50 ? 'var(--success)' : 'var(--danger)' %>"><%= sub.percentage || 0 %>%</div>
              <div style="font-size:11px;color:var(--text-muted)"><%= sub.score || 0 %>/<%= sub.total_marks || 0 %></div>
            </div>
          </div>
          <% }); } %>
        </div>
      </div>

      <!-- Groups — Expandable with student details -->
      <div class="card" style="margin-top:24px">
        <div class="card-header">
          <h3 class="card-title">👥 Student Groups</h3>
          <form method="POST" action="/groups/create-auto" style="display:inline">
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
            <button type="submit" class="btn btn-sm btn-primary">+ Create Group</button>
          </form>
        </div>
        <% if (typeof groups !== 'undefined' && groups.length > 0) { %>
          <% groups.forEach(function(group, idx) { %>
          <div class="group-accordion" style="border-bottom:1px solid var(--border);">
            <div class="group-header" onclick="toggleGroup('<%= group.id %>')" style="display:flex; justify-content:space-between; align-items:center; padding:16px; cursor:pointer; transition:background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.03)'" onmouseout="this.style.background='transparent'">
              <div style="display:flex; align-items:center; gap:12px;">
                <span id="arrow-<%= group.id %>" style="font-size:12px; transition:transform 0.3s; display:inline-block;">▶</span>
                <div>
                  <div style="font-weight:700; font-size:15px;"><%= group.name %></div>
                  <div style="font-size:12px; color:var(--text-muted);"><%= group.description || 'No description' %></div>
                </div>
              </div>
              <div style="display:flex; align-items:center; gap:12px;">
                <span class="badge badge-info"><%= group.student_count %> student<%= group.student_count !== 1 ? 's' : '' %></span>
                <button class="btn btn-sm btn-secondary" onclick="event.stopPropagation(); manageGroupStudents('<%= group.id %>', '<%= group.name %>')">Assign</button>
              </div>
            </div>
            <div id="group-body-<%= group.id %>" style="display:none; padding:0 16px 16px 44px;">
              <div style="font-size:12px; color:var(--text-muted); margin-bottom:8px;">Loading students...</div>
            </div>
          </div>
          <% }); %>
        <% } else { %>
          <div style="padding:24px; text-align:center; color:var(--text-muted);">
            No groups created yet. Click "+ Create Group" to get started.
          </div>
        <% } %>
      </div>
      </div>

      <!-- Custom Roles -->
      <div class="card" style="margin-top:24px">
        <div class="card-header">
          <h3 class="card-title">🎭 Custom Roles</h3>
          <button class="btn btn-sm btn-primary" onclick="showCreateRoleModal()">+ Create Role</button>
        </div>
        <% if (typeof customRoles !== 'undefined' && customRoles.length > 0) { %>
          <div class="table-container">
            <table>
              <thead><tr><th>Name</th><th>Visibility</th></tr></thead>
              <tbody>
                <% customRoles.forEach(function(role) { %>
                <tr>
                  <td style="font-weight:600"><%= role.name %></td>
                  <td><span class="badge badge-<%= role.is_public ? 'success' : 'warning' %>"><%= role.is_public ? 'Public' : 'Private' %></span></td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div style="padding:24px; text-align:center; color:var(--text-muted);">
            No custom roles created yet. Click "+ Create Role" to get started.
          </div>
        <% } %>
      </div>
    </div>
  </main>
</div>

<!-- Modal for Create Role -->
<div id="createRoleModal" class="modal" style="display:none; position:fixed; z-index:100; left:0; top:0; width:100%; height:100%; background:rgba(0,0,0,0.7); align-items:center; justify-content:center;">
  <div class="card" style="width:400px; padding:24px;">
    <h3 class="card-title" style="margin-bottom:20px">Create New Role</h3>
    <form action="/roles/create" method="POST">
      <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
      <div class="form-group">
        <label class="form-label">Role Name</label>
        <input type="text" name="name" class="form-input" placeholder="e.g. Teaching Assistant" required>
      </div>
      <div class="form-group">
        <label class="form-label">Visibility</label>
        <select name="is_public" class="form-select">
          <option value="1">Public</option>
          <option value="0">Private</option>
        </select>
      </div>
      <div style="display:flex; justify-content:flex-end; gap:12px; margin-top:20px">
        <button type="button" class="btn btn-secondary" onclick="document.getElementById('createRoleModal').style.display='none'">Cancel</button>
        <button type="submit" class="btn btn-primary">Create</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal for Manage Students -->
<div id="manageGroupStudentsModal" class="modal" style="display:none; position:fixed; z-index:100; left:0; top:0; width:100%; height:100%; background:rgba(0,0,0,0.7); align-items:center; justify-content:center;">
  <div class="card" style="width:500px; padding:24px;">
    <h3 class="card-title" id="manageModalTitle" style="margin-bottom:20px">Manage Group Students</h3>
    <form id="manageGroupForm" action="/groups/assign" method="POST">
      <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
      <input type="hidden" name="group_id" id="manageGroupId">
      <div style="max-height:300px; overflow-y:auto; border:1px solid var(--border); border-radius:6px; margin-bottom:20px;" id="studentSelectionContainer">
        <!-- Students will be loaded here via JS -->
      </div>
      <div style="display:flex; justify-content:flex-end; gap:12px">
        <button type="button" class="btn btn-secondary" onclick="document.getElementById('manageGroupStudentsModal').style.display='none'">Cancel</button>
        <button type="submit" class="btn btn-primary">Save Changes</button>
      </div>
    </form>
  </div>
</div>

<script>
function showCreateRoleModal() {
  document.getElementById('createRoleModal').style.display = 'flex';
}

// Expandable groups — load students on first expand
const loadedGroups = {};

async function toggleGroup(groupId) {
  const body = document.getElementById('group-body-' + groupId);
  const arrow = document.getElementById('arrow-' + groupId);
  
  if (body.style.display === 'none') {
    body.style.display = 'block';
    arrow.style.transform = 'rotate(90deg)';
    
    // Load students only the first time
    if (!loadedGroups[groupId]) {
      try {
        const res = await fetch(`/groups/${groupId}/students`);
        const data = await res.json();
        
        if (data.groupStudents.length === 0) {
          body.innerHTML = '<div style="font-size:13px; color:var(--text-muted); padding:8px 0;">No students assigned to this group yet.</div>';
        } else {
          // Find full info from allStudents
          const html = data.groupStudents.map(gs => {
            const student = data.allStudents.find(s => s.id === gs.id);
            if (!student) return '';
            return `
              <div style="display:flex; align-items:center; gap:12px; padding:10px 0; border-bottom:1px solid rgba(255,255,255,0.05);">
                <div style="width:36px; height:36px; border-radius:50%; background:var(--primary); display:flex; align-items:center; justify-content:center; font-size:14px; font-weight:700; color:white;">${student.full_name.charAt(0)}</div>
                <div style="flex:1;">
                  <div style="font-weight:600; font-size:13px;">${student.full_name}</div>
                  <div style="font-size:11px; color:var(--text-muted);">${student.department || 'No department'}</div>
                </div>
              </div>`;
          }).join('');
          body.innerHTML = html;
        }
        loadedGroups[groupId] = true;
      } catch (err) {
        body.innerHTML = '<div style="font-size:13px; color:var(--danger);">Failed to load students.</div>';
      }
    }
  } else {
    body.style.display = 'none';
    arrow.style.transform = 'rotate(0deg)';
  }
}

async function manageGroupStudents(groupId, groupName) {
  document.getElementById('manageGroupId').value = groupId;
  document.getElementById('manageModalTitle').textContent = `Manage Students: ${groupName}`;
  const container = document.getElementById('studentSelectionContainer');
  container.innerHTML = '<div style="padding:20px; text-align:center">Loading students...</div>';
  document.getElementById('manageGroupStudentsModal').style.display = 'flex';

  try {
    const res = await fetch(`/groups/${groupId}/students`);
    const data = await res.json();
    
    container.innerHTML = '';
    data.allStudents.forEach(s => {
      const isChecked = data.groupStudents.some(gs => gs.id === s.id);
      const label = document.createElement('label');
      label.style = 'display:flex; align-items:center; gap:10px; padding:10px; border-bottom:1px solid var(--border); cursor:pointer';
      label.innerHTML = `
        <input type="checkbox" name="student_ids" value="${s.id}" ${isChecked ? 'checked' : ''}>
        <div>
          <div style="font-weight:600; font-size:13px">${s.full_name}</div>
          <div style="font-size:11px; color:var(--text-muted)">${s.department}</div>
        </div>
      `;
      container.appendChild(label);
    });
  } catch (err) {
    container.innerHTML = '<div style="padding:20px; color:var(--danger)">Failed to load students.</div>';
  }
}
</script>
<%- include('../partials/footer') %>
